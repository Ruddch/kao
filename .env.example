VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Ethereum mainnet RPC for Studio/Reveal reads.
# IMPORTANT: must be an ETH mainnet endpoint — a leftover Base RPC URL will break reads
# (balanceOf returns 0x because the contract only exists on Ethereum).
# Use Alchemy/Infura/etc.; public fallback is ethereum.publicnode.com if unset.
VITE_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
